# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Render runs behind one proxy: set TRUST_PROXY=1 there.
TRUST_PROXY=0
# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# ── Database (Neon) ──────────────────────────────────────────────────────────
# App traffic: the POOLED connection string (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Migrations: the DIRECT connection string (same host without "-pooler").
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ── Auth ─────────────────────────────────────────────────────────────────────
# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-32-plus-chars

# ── KYC (Dojah sandbox) ──────────────────────────────────────────────────────
# "mock" skips Dojah entirely (offline dev, tests).
KYC_PROVIDER=dojah
DOJAH_BASE_URL=https://sandbox.dojah.io
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
# The sandbox returns the same test person for everyone, so leave this off there.
KYC_ENFORCE_NAME_MATCH=false
# The sandbox returns the same fixed liveness ("spoof") and document ("INVALID")
# verdict for every image. true = still require a face/document, ignore that verdict.
# Has no effect against the live API.
DOJAH_SANDBOX_TRUST_CHECKS=true

# ── File storage (Neon Object Storage, S3-compatible) ────────────────────────
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
# A public_read bucket: profile photos are served straight from it.
STORAGE_BUCKET=paysplit
# Optional CDN/base URL for objects; defaults to ${AWS_ENDPOINT_URL_S3}/${STORAGE_BUCKET}
STORAGE_PUBLIC_URL=

# ── Simulations ──────────────────────────────────────────────────────────────
# Enables POST /api/v1/simulations/salary-credit (fake salary payments).
ENABLE_SIMULATIONS=true
