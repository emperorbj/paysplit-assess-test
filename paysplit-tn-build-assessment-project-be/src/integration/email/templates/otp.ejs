<div style="font-family: Arial, sans-serif; max-width: 600px; margin: auto; border: 1px solid #ddd; padding: 20px; border-radius: 10px;">
    <h2 style="color: #333; text-align: center;"><%= heading %></h2>
    <p>Hello<%= firstName ? ` ${firstName}` : '' %>,</p>
    <p><%= intro %></p>
    <div style="font-size: 32px; font-weight: bold; text-align: center; letter-spacing: 5px; color: #4A90E2; margin: 30px 0;">
        <%= otp %>
    </div>
    <p>This code will expire in <%= expiresInMinutes %> minutes. If you did not request this, please ignore this email.</p>
    <hr style="border: 0; border-top: 1px solid #eee; margin: 20px 0;">
    <p style="font-size: 12px; color: #888; text-align: center;">&copy; <%= new Date().getFullYear() %> PaySplit. All rights reserved.</p>
</div>
